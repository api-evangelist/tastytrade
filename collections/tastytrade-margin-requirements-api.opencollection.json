                "type": "path"
              }
            ]
          },
          "docs": "Fetch current margin/captial requirements report for an account"
        },
        {
          "info": {
            "name": "createMarginAccountsAccountNumberDryRun",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/margin/accounts/:account_number/dry-run",
            "params": [
              {
                "name": "account_number",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Estimate margin requirements for an order given an account"
        }
      ]
    }
  ],
  "bundled": true
