              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Replaces a live order with a new one. Subsequent fills of the original order will abort the replacement."
        },
        {
          "info": {
            "name": "patchAccountsAccountNumberOrdersId",
            "type": "http"
