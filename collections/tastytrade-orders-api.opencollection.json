{
  "opencollection": "1.0.0",
  "info": {
    "name": "Account Status accounts orders API",
    "version": "7.1.0"
  },
  "items": [
    {
      "info": {
        "name": "orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getAccountsAccountNumberOrders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/accounts/:account_number/orders",
            "params": [
              {
                "name": "account_number",
                "value": "",
                "type": "path"
              },
              {
                "name": "page-offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "per-page",
                "value": "",
                "type": "query"
              },
              {
                "name": "end-at",
                "value": "",
                "type": "query",
                "description": "DateTime end range for filtering orders in full date-time"
              },
              {
                "name": "end-date",
                "value": "",
                "type": "query"
              },
              {
                "name": "futures-symbol",
                "value": "",
                "type": "query",
                "description": "Used to fetch both futures and futures options orders"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "The order to sort results in. Accepts `Desc` or `Asc`. Defaults to `Desc`"
              },
              {
                "name": "start-at",
                "value": "",
                "type": "query",
                "description": "DateTime start rage for filtering orders in full date-time. Required if start-date param not provided"
              },
              {
                "name": "start-date",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": " (example: status[]={value1}&status[]={value2})"
              },
              {
                "name": "underlying-instrument-type",
                "value": "",
                "type": "query",
                "description": "Underlying instrument type"
              },
              {
                "name": "underlying-symbol",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a paginated list of the customer's orders (as identified by the provided authentication token)\n      based on sort param. If no sort is passed in, it defaults to descending order."
        },
        {
          "info": {
            "name": "postAccountsAccountNumberOrders",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/accounts/:account_number/orders",
            "params": [
              {
                "name": "account_number",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Accepts a json document containing parameters to create an order for the client."
        },
        {
          "info": {
            "name": "postAccountsAccountNumberOrdersDryRun",
